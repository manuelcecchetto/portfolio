---
import { getCopy, resolveLocale } from "../../lib/i18n";

export interface Props {
  currentPage: number;
  totalPages: number;
  previousPageHref: string | undefined;
  nextPageHref: string | undefined;
}

const { currentPage, totalPages, previousPageHref, nextPageHref } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);

if (totalPages < 1) {
  throw new Error("BlogPagination requires totalPages >= 1.");
}
---

{
  totalPages > 1 && (
    <nav class="blog-pagination" aria-label={t.blogPagination.aria}>
      {previousPageHref ? (
        <a class="cta cta--secondary" href={previousPageHref}>
          <span aria-hidden="true">←</span> {t.blogPagination.newerPosts}
        </a>
      ) : (
        <span />
      )}
      <p class="blog-pagination__status">
        {t.blogPagination.pageLabel} {currentPage} / {totalPages}
      </p>
      {nextPageHref ? (
        <a class="cta cta--secondary" href={nextPageHref}>
          {t.blogPagination.olderPosts} <span class="cta__arrow" aria-hidden="true">→</span>
        </a>
      ) : (
        <span />
      )}
    </nav>
  )
}

<style>
  .blog-pagination {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .blog-pagination > :last-child {
    justify-self: end;
  }

  .blog-pagination > :first-child {
    justify-self: start;
  }

  .blog-pagination__status {
    font-weight: 600;
    color: var(--color-text-muted);
  }
</style>
