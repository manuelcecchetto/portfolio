---
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import LiquidDivider from "../components/ui/LiquidDivider.astro";
import type { Tone } from "../lib/tones";
import {
  DEFAULT_LOCALE,
  SUPPORTED_LOCALES,
  getCopy,
  localizePath,
  resolveLocale,
  stripLocaleFromPath,
} from "../lib/i18n";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  image?: string | undefined;
  noindex?: boolean;
  /** "home" renders full-bleed sections; "page" wraps content in the reading shell. */
  variant?: "home" | "page";
  /** Pastel band behind the `hero` slot on inner pages. */
  tone?: Tone;
}

const {
  title = "manuelcecchetto.it",
  ogType = "website",
  image,
  noindex = false,
  variant = "page",
  tone = "lavender",
} = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);
const description = Astro.props.description ?? t.seo.defaultDescription;
const currentPath = Astro.url.pathname;
const pathWithoutLocale = stripLocaleFromPath(currentPath);
const siteOrigin = Astro.site ?? new URL("https://manuelcecchetto.it");
const canonicalUrl = new URL(currentPath, siteOrigin).href;
const feedUrl = new URL("/rss.xml", siteOrigin).href;
const sitemapUrl = new URL("/sitemap-index.xml", siteOrigin).href;
const localeAlternates = SUPPORTED_LOCALES.map((entryLocale) => ({
  locale: entryLocale,
  href: new URL(localizePath(entryLocale, pathWithoutLocale), siteOrigin).href,
}));
const defaultAlternateHref = new URL(localizePath(DEFAULT_LOCALE, pathWithoutLocale), siteOrigin).href;
const resolvedImage = image ? new URL(image, siteOrigin).href : undefined;
const twitterCardType = resolvedImage ? "summary_large_image" : "summary";
const robots = noindex ? "noindex, nofollow" : "index, follow";
const googleFontsHref =
  "https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500&display=swap";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#faf4eb" />
    <script is:inline src="/scripts/js-flag.js"></script>
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:site_name" content="manuelcecchetto.it" />
    <meta name="twitter:card" content={twitterCardType} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {resolvedImage && <meta property="og:image" content={resolvedImage} />}
    {resolvedImage && <meta name="twitter:image" content={resolvedImage} />}
    <link rel="alternate" type="application/rss+xml" title={t.layout.rssTitle} href={feedUrl} />
    {localeAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.locale} href={alternate.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultAlternateHref} />
    <link rel="sitemap" href={sitemapUrl} />
    <link rel="dns-prefetch" href="//fonts.googleapis.com" />
    <link rel="dns-prefetch" href="//fonts.gstatic.com" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link rel="preload" as="style" href={googleFontsHref} />
    <link href={googleFontsHref} rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.layout.skipToContent}</a>
    <div class="site-frame">
      <Header currentPath={currentPath} locale={locale} />
      {
        variant === "home" ? (
          <main id="main-content" class="site-main site-main--home">
            <slot name="hero" />
            <slot />
          </main>
        ) : (
          <>
            <main id="main-content" class="site-main site-main--page">
              {Astro.slots.has("hero") && (
                <>
                  <div class="page-band" style={`--band-bg: var(--${tone})`}>
                    <div class="site-shell">
                      <slot name="hero" />
                    </div>
                  </div>
                  <LiquidDivider from={`var(--${tone})`} to="var(--cream)" class="page-band__divider" />
                </>
              )}
              <div class="site-shell site-main__inner">
                <slot />
              </div>
            </main>
            <LiquidDivider from="var(--cream)" to="var(--charcoal)" />
          </>
        )
      }
      <Footer locale={locale} />
    </div>
    <script>
      const targets = document.querySelectorAll(".motion-reveal, .motion-stagger");
      if (!("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-in");
                observer.unobserve(entry.target);
              }
            }
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.12 },
        );
        targets.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
