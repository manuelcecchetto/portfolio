---
interface Props {
  title?: string;
  language?: string;
  code: string;
}

const { title = "Code note", language = "txt", code } = Astro.props as Props;
---

<figure class="prose-code-note" aria-label={title}>
  <figcaption class="prose-code-note__bar">
    <span class="prose-code-note__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="prose-code-note__title">{title}</span>
    <span class="prose-code-note__lang">{language}</span>
  </figcaption>
  <pre><code class={`language-${language}`}>{code}</code></pre>
</figure>

<style>
  .prose-code-note {
    margin-block: 1.8em;
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--ink);
    background: var(--charcoal);
    overflow: hidden;
  }

  .prose-code-note__bar {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.7rem 1.1rem;
    border-bottom: 1px solid var(--line-dark);
    background: var(--charcoal-soft);
    color: #c3c7ce;
    font-size: 0.85rem;
    font-weight: 600;
  }

  .prose-code-note__dots {
    display: inline-flex;
    gap: 0.35rem;
  }

  .prose-code-note__dots i {
    width: 0.62rem;
    height: 0.62rem;
    border-radius: 50%;
    background: #4a4e54;
  }

  .prose-code-note__dots i:first-child {
    background: #ff8a80;
  }

  .prose-code-note__dots i:nth-child(2) {
    background: #ffd56b;
  }

  .prose-code-note__dots i:last-child {
    background: #8fd9a0;
  }

  .prose-code-note__title {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .prose-code-note__lang {
    font-family: var(--font-mono);
    font-weight: 500;
    color: #9499a1;
  }

  .prose-code-note pre {
    margin: 0;
    padding: 1.1rem 1.3rem 1.2rem;
    border-radius: 0;
    font-size: 0.86rem;
    line-height: 1.7;
    color: #f1ece4;
  }
</style>
