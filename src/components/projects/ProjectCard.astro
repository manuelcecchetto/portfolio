---
import type { ProjectEntry } from "../../lib/content";
import { getCopy, localizePath, resolveLocale, toIntlLocale } from "../../lib/i18n";
import type { Tone } from "../../lib/tones";

export interface Props {
  project: ProjectEntry;
  tone: Tone;
  /** "feature" is a wide horizontal card; "compact" stacks media over text. */
  size?: "feature" | "compact";
  /** Put the media on the right (feature cards alternate). */
  flip?: boolean;
  level?: 2 | 3;
}

const { project, tone, size = "compact", flip = false, level = 3 } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);

const href = localizePath(locale, `/projects/${project.data.slug}/`);
const tags = project.data.tags.slice(0, size === "feature" ? 5 : 3);
const Heading = `h${level}` as "h2" | "h3";
const dateLabel = new Intl.DateTimeFormat(toIntlLocale(locale), { month: "short", year: "numeric" }).format(
  project.data.updatedAt ?? project.data.publishedAt,
);
---

<article class:list={["project-card", `project-card--${size}`, { "project-card--flip": flip }]} style={`--tone: var(--${tone})`}>
  {
    project.data.coverImage && (
      <div class="project-card__media">
        <img src={project.data.coverImage} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="project-card__body">
    <Heading class="project-card__title">
      <a href={href}>{project.data.title}</a>
    </Heading>
    <p class="project-card__summary">{project.data.summary}</p>

    {
      tags.length > 0 && (
        <ul class="chip-list" aria-label={t.projectCard.tagsAria}>
          {tags.map((tag) => (
            <li class="chip">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="project-card__foot">
      <span class="link-arrow" aria-hidden="true">{t.projectCard.openDetails}</span>
      <span class="project-card__date">{dateLabel}</span>
      {
        project.data.repositoryUrl && (
          <a class="project-card__repo" href={project.data.repositoryUrl} target="_blank" rel="noreferrer" aria-label={`${t.projectCard.repository}: ${project.data.title}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 1.5C6.2 1.5 1.5 6.2 1.5 12c0 4.66 3.02 8.6 7.2 9.99.53.1.72-.22.72-.5 0-.25-.01-1.08-.01-1.95-2.63.48-3.32-.64-3.53-1.23-.12-.3-.64-1.23-1.09-1.47-.37-.2-.9-.7-.01-.71.84-.01 1.44.77 1.64 1.09.96 1.61 2.49 1.15 3.1.88.1-.7.37-1.15.67-1.41-2.33-.27-4.77-1.16-4.77-5.17 0-1.14.4-2.08 1.08-2.81-.11-.27-.48-1.37.1-2.86 0 0 .88-.28 2.88 1.07a9.8 9.8 0 0 1 5.24 0c2-1.36 2.88-1.07 2.88-1.07.58 1.49.21 2.59.1 2.86.67.73 1.08 1.66 1.08 2.81 0 4.02-2.45 4.89-4.78 5.15.38.32.7.93.7 1.89 0 1.36-.01 2.45-.01 2.79 0 .27.19.6.72.5A10.51 10.51 0 0 0 22.5 12c0-5.8-4.7-10.5-10.5-10.5Z" />
            </svg>
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    position: relative;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    align-content: start;
    height: 100%;
    padding: clamp(0.9rem, 1.6vw, 1.15rem);
    border-radius: var(--radius-xl);
    background: var(--tone);
    border: 1.5px solid var(--ink);
    transition:
      transform var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-out-soft);
  }

  .project-card:hover,
  .project-card:focus-within {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .project-card--feature {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    align-items: center;
  }

  .project-card--flip .project-card__media {
    order: 2;
  }

  .project-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 1.1rem;
    border: 1.5px solid var(--ink);
    background: var(--charcoal);
  }

  .project-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-soft);
  }

  .project-card:hover .project-card__media img {
    transform: scale(1.035);
  }

  .project-card__body {
    display: grid;
    gap: var(--space-4);
    align-content: start;
    padding: 0.35rem clamp(0.35rem, 1.2vw, 0.9rem) 0.5rem;
  }

  .project-card__title {
    font-size: clamp(1.35rem, 2vw, 1.6rem);
    letter-spacing: -0.035em;
    line-height: 1.08;
  }

  .project-card--feature .project-card__title {
    font-size: clamp(1.7rem, 3vw, 2.45rem);
    letter-spacing: -0.045em;
  }

  .project-card__title a {
    text-decoration: none;
  }

  /* The whole card is the link target; the repo icon sits above it. */
  .project-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .project-card__title a:focus-visible {
    outline: none;
  }

  .project-card:has(.project-card__title a:focus-visible) {
    outline: 2.5px solid var(--color-focus-ring);
    outline-offset: 4px;
  }

  .project-card__summary {
    color: var(--color-text-body);
  }

  .project-card--feature .project-card__summary {
    font-size: 1.1rem;
  }

  .project-card__foot {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    margin-top: var(--space-1);
  }

  .project-card__date {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    font-weight: 500;
  }

  .project-card:hover .link-arrow::after {
    transform: translateX(4px);
  }

  .project-card__repo {
    position: relative;
    z-index: 1;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    border: 1.5px solid var(--ink);
    background: #fff;
    color: var(--ink);
    transition:
      background var(--duration-fast) ease,
      color var(--duration-fast) ease;
  }

  .project-card__repo:hover {
    background: var(--ink);
    color: var(--cream);
  }

  .project-card__repo svg {
    width: 1.15rem;
    height: 1.15rem;
    fill: currentColor;
  }

  @media (max-width: 52rem) {
    .project-card--feature {
      grid-template-columns: 1fr;
    }

    .project-card--flip .project-card__media {
      order: 0;
    }
  }
</style>
