---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/projects/ProjectCard.astro";
import ProjectDetailsPanel from "../../components/projects/ProjectDetailsPanel.astro";
import {
  getLocalizedProjectBySlug,
  getLocalizedProjects,
  getProjectRouteSlugs,
  orderProjectsForDisplay,
} from "../../lib/content";
import { getCopy, localizePath, resolveLocale } from "../../lib/i18n";
import { toneAt } from "../../lib/tones";

export async function getStaticPaths() {
  const slugs = await getProjectRouteSlugs({ includeDrafts: !import.meta.env.PROD });
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

interface Props {
  slug: string;
}

const locale = resolveLocale(Astro.currentLocale);
const { slug: slugFromProps } = Astro.props as Props;
const slug = slugFromProps ?? Astro.params.slug;
if (!slug) {
  throw new Error("Missing project slug param.");
}

const project = await getLocalizedProjectBySlug(slug, locale);
if (!project) {
  throw new Error(`Unable to resolve localized project for slug '${slug}' in locale '${locale}'.`);
}

// Same order as the index, so the hero band matches the card color.
const ordered = orderProjectsForDisplay(await getLocalizedProjects(locale));
const position = ordered.findIndex((entry) => entry.data.translationGroup === project.data.translationGroup);
const related = ordered
  .map((entry, index) => ({ entry, tone: toneAt(index) }))
  .filter(({ entry }) => entry.data.translationGroup !== project.data.translationGroup)
  .slice(0, 3);
const { Content } = await render(project);
const t = getCopy(locale);
---

<BaseLayout
  title={`${project.data.title} | ${t.seo.projectsDetailSuffix}`}
  description={project.data.summary}
  ogType="article"
  image={project.data.coverImage}
  tone={toneAt(Math.max(0, position))}
>
  <header class="page-hero project-hero motion-reveal" slot="hero">
    <a class="back-link" href={localizePath(locale, "/projects")}>{t.projectDetail.backToAll}</a>
    <h1>{project.data.title}</h1>
    <p class="page-hero__lead">{project.data.summary}</p>
  </header>

  {
    project.data.coverImage && (
      <img
        class="project-cover motion-reveal"
        src={project.data.coverImage}
        alt={`${t.projectDetail.coverAltPrefix} ${project.data.title}`}
        loading="eager"
        decoding="async"
      />
    )
  }

  <div class="project-layout">
    <article class="prose">
      <Content />
    </article>
    <div class="project-layout__aside">
      <ProjectDetailsPanel project={project} />
    </div>
  </div>

  {
    related.length > 0 && (
      <section aria-labelledby="project-related-title">
        <div class="section-head motion-reveal">
          <h2 id="project-related-title" class="section-title">{t.projectDetail.relatedTitle}</h2>
          <a class="link-arrow" href={localizePath(locale, "/projects")}>{t.projectDetail.backToAll}</a>
        </div>
        <ul class="project-related motion-stagger" role="list">
          {related.map(({ entry, tone }) => (
            <li>
              <ProjectCard project={entry} tone={tone} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .project-hero h1 {
    max-width: 20ch;
    font-size: clamp(2.4rem, 5.6vw, 4.8rem);
  }

  .project-cover {
    width: 100%;
    max-height: 40rem;
    object-fit: cover;
    object-position: top;
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    background: var(--charcoal);
  }

  .project-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 20rem);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }

  .project-layout__aside {
    position: sticky;
    top: 6rem;
  }

  .project-related {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  @media (max-width: 60rem) {
    .project-layout {
      grid-template-columns: 1fr;
    }

    .project-layout__aside {
      position: static;
    }
  }
</style>
