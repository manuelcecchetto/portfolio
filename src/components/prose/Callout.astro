---
interface Props {
  title?: string;
  tone?: "warm" | "cool" | "caution";
}

const { title = "Note", tone = "warm" } = Astro.props as Props;
---

<aside class={`prose-callout prose-callout--${tone}`} aria-label={title}>
  <p class="prose-callout__title">{title}</p>
  <div class="prose-callout__body">
    <slot />
  </div>
</aside>

<style>
  .prose-callout {
    margin-block: 1.8em;
    padding: 1.2rem 1.4rem 1.3rem;
    border-radius: var(--radius-lg);
    background: var(--callout-bg);
    border: 1.5px solid var(--ink);
    font-size: 1.05rem;
    line-height: 1.65;
  }

  .prose-callout__title {
    margin-bottom: 0.35rem;
    font-family: var(--font-note);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ink);
  }

  .prose-callout__body :global(p + p) {
    margin-top: 0.6em;
  }

  .prose-callout--warm {
    --callout-bg: var(--peach);
  }

  .prose-callout--cool {
    --callout-bg: var(--lavender);
  }

  .prose-callout--caution {
    --callout-bg: var(--butter);
  }
</style>
