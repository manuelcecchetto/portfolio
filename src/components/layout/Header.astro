---
import Nav from "./Nav.astro";
import { localizePath, type SiteLocale } from "../../lib/i18n";

export interface Props {
  currentPath: string;
  locale: SiteLocale;
}

const { currentPath, locale } = Astro.props;
---

<header class="site-header">
  <div class="site-shell site-header__inner">
    <a class="site-brand" href={localizePath(locale, "/")}>
      <span class="site-brand__avatar">
        <img src="/images/characters/avatar.webp" alt="" width="96" height="96" />
      </span>
      Manuel Cecchetto
    </a>
    <Nav currentPath={currentPath} locale={locale} />
  </div>
</header>
