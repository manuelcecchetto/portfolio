---
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import BlogPagination from "../../components/blog/BlogPagination.astro";
import { BLOG_PAGE_SIZE, getBlogTagSummaries, getLocalizedBlogPosts, paginateEntries } from "../../lib/content";
import { getCopy, resolveLocale } from "../../lib/i18n";
import { toneAt } from "../../lib/tones";

const locale = resolveLocale(Astro.currentLocale);
const posts = await getLocalizedBlogPosts(locale);
const t = getCopy(locale);
const tagSummaries = getBlogTagSummaries(posts, locale).slice(0, 12);
const pagination = paginateEntries(posts, 1, BLOG_PAGE_SIZE, "/blog", locale);
const [lead, ...rest] = pagination.items;
---

<BaseLayout title={t.seo.blogTitle} description={t.seo.blogDescription} tone="butter">
  <section class="page-hero blog-hero" slot="hero">
    <div class="blog-hero__text motion-reveal">
      <h1>{t.blogPage.heroTitle}</h1>
      <p class="page-hero__lead">{t.blogPage.heroText}</p>
      {
        tagSummaries.length > 0 && (
          <ul class="chip-list" aria-label={t.blogPage.tagsAria}>
            {tagSummaries.map((summary) => (
              <li>
                <a class="chip" href={summary.href}>
                  {summary.tag} <span class="chip__count">{summary.count}</span>
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
    <img class="blog-hero__character" src="/images/characters/coffee.webp" alt="" width="640" height="640" decoding="async" />
  </section>

  {
    posts.length === 0 ? (
      <p class="text-muted">{t.blogPage.emptyState}</p>
    ) : (
      <section class="blog-list" aria-label={t.blogPage.latestPostsTitle}>
        {lead && (
          <div class="motion-reveal">
            <BlogCard post={lead} tone={toneAt(0)} size="feature" />
          </div>
        )}
        {rest.length > 0 && (
          <ul class="blog-list__rows motion-stagger" role="list">
            {rest.map((post, index) => (
              <li>
                <BlogCard post={post} tone={toneAt(index + 1)} />
              </li>
            ))}
          </ul>
        )}
        <BlogPagination
          currentPage={pagination.page}
          totalPages={pagination.totalPages}
          previousPageHref={pagination.previousPageHref}
          nextPageHref={pagination.nextPageHref}
        />
      </section>
    )
  }
</BaseLayout>

<style>
  .blog-hero {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
  }

  .blog-hero__text {
    display: grid;
    gap: var(--space-5);
  }

  .blog-hero__text .chip-list {
    max-width: 44rem;
    margin-top: var(--space-2);
  }

  .blog-hero__character {
    width: clamp(12rem, 20vw, 17rem);
    height: auto;
    margin-bottom: calc(-1 * clamp(1rem, 3vw, 2.5rem));
  }

  .blog-list {
    display: grid;
    gap: clamp(1.5rem, 3vw, 2.5rem);
  }

  .blog-list__rows {
    display: grid;
  }

  .blog-list__rows > li + li {
    border-top: 1px solid var(--color-border-soft);
  }

  @media (max-width: 40rem) {
    .blog-hero__text .chip-list > :nth-child(n + 7) {
      display: none;
    }
  }

  @media (max-width: 52rem) {
    .blog-hero {
      grid-template-columns: 1fr;
    }

    .blog-hero__character {
      display: none;
    }
  }
</style>
