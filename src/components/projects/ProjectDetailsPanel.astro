---
import type { ProjectEntry } from "../../lib/content";
import { getCopy, resolveLocale, toIntlLocale } from "../../lib/i18n";

export interface Props {
  project: ProjectEntry;
}

const { project } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);

const dateFormatter = new Intl.DateTimeFormat(toIntlLocale(locale), { month: "long", year: "numeric" });
const publishedLabel = dateFormatter.format(project.data.publishedAt);
const updatedLabel = project.data.updatedAt ? dateFormatter.format(project.data.updatedAt) : undefined;
const hasLinks = Boolean(project.data.repositoryUrl || project.data.demoUrl);
---

<aside class="glance" aria-labelledby="glance-title">
  <h2 id="glance-title" class="glance__title">{t.projectDetailsPanel.title}</h2>

  <dl class="glance__list">
    <div>
      <dt>{t.common.publishedPrefix}</dt>
      <dd>{publishedLabel}</dd>
    </div>
    {
      updatedLabel && (
        <div>
          <dt>{t.projectDetailsPanel.lastUpdate}</dt>
          <dd>{updatedLabel}</dd>
        </div>
      )
    }
    {
      project.data.tags.length > 0 && (
        <div>
          <dt>{t.projectDetailsPanel.stackAndThemes}</dt>
          <dd>
            <ul class="chip-list">
              {project.data.tags.map((tag) => (
                <li class="chip">{tag}</li>
              ))}
            </ul>
          </dd>
        </div>
      )
    }
  </dl>

  <div class="glance__links">
    {
      project.data.repositoryUrl && (
        <a class="cta cta--primary" href={project.data.repositoryUrl} target="_blank" rel="noreferrer">
          {t.projectDetailsPanel.viewRepository} <span class="cta__arrow" aria-hidden="true">↗</span>
        </a>
      )
    }
    {
      project.data.demoUrl && (
        <a class="cta cta--secondary" href={project.data.demoUrl} target="_blank" rel="noreferrer">
          {t.projectDetailsPanel.openLiveDemo} <span class="cta__arrow" aria-hidden="true">↗</span>
        </a>
      )
    }
    {!hasLinks && <p class="glance__private hand">{t.projectDetailsPanel.noExternalLinks}</p>}
  </div>
</aside>

<style>
  .glance {
    display: grid;
    gap: var(--space-5);
    padding: clamp(1.25rem, 2.4vw, 1.6rem);
    border-radius: var(--radius-xl);
    background: var(--color-surface);
    border: 1.5px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
  }

  .glance__title {
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }

  .glance__list {
    display: grid;
    gap: var(--space-4);
    margin: 0;
  }

  .glance__list div {
    display: grid;
    gap: 0.3rem;
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border-soft);
  }

  .glance__list dt {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--color-text-muted);
  }

  .glance__list dd {
    margin: 0;
    font-weight: 700;
    color: var(--ink);
  }

  .glance__links {
    display: grid;
    gap: var(--space-3);
  }

  .glance__private {
    font-size: 1.5rem;
    color: var(--ink);
    transform: rotate(-2deg);
    transform-origin: left;
  }
</style>
