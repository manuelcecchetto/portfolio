---
import BlogTagPage from "../../../blog/tags/[tag].astro";
import { getBlogTagSummaries, getLocalizedBlogPosts } from "../../../../lib/content";
import { NON_DEFAULT_LOCALES } from "../../../../lib/i18n";

// Tags come from each locale's own posts: translated entries carry translated tags.
export async function getStaticPaths() {
  const includeDrafts = !import.meta.env.PROD;
  const perLocale = await Promise.all(
    NON_DEFAULT_LOCALES.map(async (locale) => {
      const posts = await getLocalizedBlogPosts(locale, { includeDrafts });
      return getBlogTagSummaries(posts, locale).map(({ tag }) => ({ params: { locale, tag }, props: { tag } }));
    }),
  );
  return perLocale.flat();
}
---

<BlogTagPage {...Astro.props} />
