---
export interface Props {
  label: string;
  hint?: string;
  ratio?: "wide" | "landscape" | "portrait" | "square";
  class?: string;
}

const { label, hint = "Image pending", ratio = "landscape", class: className = "" } = Astro.props;
---

<figure class:list={["image-placeholder", `image-placeholder--${ratio}`, className]} aria-label={label}>
  <figcaption>
    <span class="image-placeholder__label">{label}</span>
    <span class="image-placeholder__hint hand">{hint}</span>
  </figcaption>
</figure>

<style>
  .image-placeholder {
    display: grid;
    place-items: center;
    margin: 0;
    padding: var(--space-6);
    border-radius: var(--radius-lg);
    border: 1.5px dashed var(--ink);
    background: var(--cream-deep);
    text-align: center;
  }

  .image-placeholder--wide {
    aspect-ratio: 21 / 9;
  }

  .image-placeholder--landscape {
    aspect-ratio: 16 / 10;
  }

  .image-placeholder--portrait {
    aspect-ratio: 4 / 5;
  }

  .image-placeholder--square {
    aspect-ratio: 1;
  }

  .image-placeholder figcaption {
    display: grid;
    gap: 0.3rem;
  }

  .image-placeholder__label {
    font-weight: 700;
    color: var(--ink);
  }

  .image-placeholder__hint {
    font-size: 1.4rem;
    color: var(--color-text-muted);
  }
</style>
