---
import BaseLayout from "../layouts/BaseLayout.astro";
import LiquidDivider from "../components/ui/LiquidDivider.astro";
import Hero from "../components/home/Hero.astro";
import WhatIDo from "../components/home/WhatIDo.astro";
import Casus from "../components/home/Casus.astro";
import Work from "../components/home/Work.astro";
import Toolkit from "../components/home/Toolkit.astro";
import About from "../components/home/About.astro";
import Contact from "../components/home/Contact.astro";
import { getLocalizedBlogPosts, getLocalizedProjects } from "../lib/content";
import { getHomeCopy } from "../lib/home-copy";
import { getCopy, resolveLocale } from "../lib/i18n";

const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);
const copy = getHomeCopy(locale);
const [projects, posts] = await Promise.all([
  getLocalizedProjects(locale, { includeDrafts: false }),
  getLocalizedBlogPosts(locale, { includeDrafts: false }),
]);
---

<BaseLayout title={t.seo.homeTitle} description={t.seo.homeDescription} variant="home">
  <Hero copy={copy.hero} />
  <LiquidDivider from="var(--cream)" to="var(--charcoal)" />
  <WhatIDo copy={copy.what} />
  <LiquidDivider from="var(--charcoal)" to="var(--casus-navy)" />
  <Casus copy={copy.casus} />
  <LiquidDivider from="var(--casus-navy)" to="var(--cream)" />
  <Work copy={copy.work} locale={locale} projects={projects} posts={posts.slice(0, 3)} />
  <LiquidDivider from="var(--cream)" to="var(--charcoal)" />
  <Toolkit copy={copy.toolkit} />
  <LiquidDivider from="var(--charcoal)" to="var(--lavender)" />
  <About copy={copy.about} story={t.profile.aboutLong} />
  <LiquidDivider from="var(--lavender)" to="var(--charcoal)" />
  <Contact copy={copy.contact} />
</BaseLayout>
