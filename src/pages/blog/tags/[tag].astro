---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import BlogCard from "../../../components/blog/BlogCard.astro";
import { getBlogTagSummaries, getLocalizedBlogPosts } from "../../../lib/content";
import { DEFAULT_LOCALE, getCopy, localizePath, resolveLocale } from "../../../lib/i18n";
import { toneAt } from "../../../lib/tones";

export async function getStaticPaths() {
  const posts = await getLocalizedBlogPosts(DEFAULT_LOCALE, { includeDrafts: !import.meta.env.PROD });
  const tags = getBlogTagSummaries(posts, DEFAULT_LOCALE);
  return tags.map(({ tag }) => ({ params: { tag }, props: { tag } }));
}

interface Props {
  tag: string;
}

const { tag: tagFromProps } = Astro.props as Props;
const tag = tagFromProps ?? Astro.params.tag;
const locale = resolveLocale(Astro.currentLocale);
if (!tag) {
  throw new Error("Missing blog tag param.");
}

const allPosts = await getLocalizedBlogPosts(locale);
const tags = getBlogTagSummaries(allPosts, locale);
// Keep each post's index-based tone so colors match the main archive.
const posts = allPosts
  .map((post, index) => ({ post, tone: toneAt(index) }))
  .filter(({ post }) => post.data.tags.includes(tag));
const t = getCopy(locale);
const siblingTags = tags.filter((summary) => summary.tag !== tag).slice(0, 10);
---

<BaseLayout title={`${tag} | ${t.seo.blogTagSuffix}`} description={`${t.blogTagPage.tagPrefix}: ${tag}.`} tone="butter">
  <section class="page-hero motion-reveal" slot="hero">
    <a class="back-link" href={localizePath(locale, "/blog")}>{t.blogTagPage.backToAll}</a>
    <h1><span class="tag-hash" aria-hidden="true">#</span>{tag}</h1>
    <p class="page-hero__lead">
      {t.blogTagPage.showingPostsPrefix} {posts.length}{" "}
      {posts.length === 1 ? t.blogTagPage.showingPostsSuffixSingle : t.blogTagPage.showingPostsSuffixPlural}
    </p>
    {
      siblingTags.length > 0 && (
        <ul class="chip-list" aria-label={t.blogTagPage.relatedTagsAria}>
          {siblingTags.map((summary) => (
            <li>
              <a class="chip" href={summary.href}>
                {summary.tag} <span class="chip__count">{summary.count}</span>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </section>

  {
    posts.length === 0 ? (
      <p class="text-muted">{t.blogTagPage.noPosts}</p>
    ) : (
      <ul class="tag-rows motion-stagger" role="list" aria-label={t.blogTagPage.postsInArchive}>
        {posts.map(({ post, tone }) => (
          <li>
            <BlogCard post={post} tone={tone} />
          </li>
        ))}
      </ul>
    )
  }
</BaseLayout>

<style>
  .tag-hash {
    color: var(--color-highlight);
    margin-right: 0.04em;
  }

  .tag-rows {
    display: grid;
  }

  .tag-rows > li + li {
    border-top: 1px solid var(--color-border-soft);
  }
</style>
