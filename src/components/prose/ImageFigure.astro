---
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props as Props;
---

<figure class="prose-figure">
  {
    src ? (
      <img src={src} alt={alt} loading="lazy" decoding="async" />
    ) : (
      <ImagePlaceholder label={alt} hint="Inline figure placeholder" ratio="wide" />
    )
  }
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .prose-figure {
    display: grid;
    gap: 0.8rem;
    margin-block: 2em;
  }

  .prose-figure img {
    width: 100%;
    height: auto;
    border-radius: var(--radius-lg);
    border: 1.5px solid var(--ink);
    box-shadow: 6px 6px 0 var(--ink);
    background: var(--charcoal);
  }

  .prose-figure figcaption {
    display: flex;
    gap: 0.5rem;
    padding-left: 0.2rem;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--color-text-muted);
  }

  .prose-figure figcaption::before {
    content: "↑";
    font-weight: 700;
    color: var(--ink);
  }
</style>
