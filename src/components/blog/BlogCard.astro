---
import type { BlogEntry } from "../../lib/content";
import { getCopy, localizePath, resolveLocale, toIntlLocale } from "../../lib/i18n";
import type { Tone } from "../../lib/tones";

export interface Props {
  post: BlogEntry;
  tone: Tone;
  /** "feature" leads a list, "row" is a list line that lights up on hover, "compact" stacks for grids. */
  size?: "feature" | "row" | "compact";
  level?: 2 | 3;
}

const { post, tone, size = "row", level = 2 } = Astro.props;
const locale = resolveLocale(Astro.currentLocale);
const t = getCopy(locale);
const href = localizePath(locale, `/blog/${post.data.slug}/`);
const Heading = `h${level}` as "h2" | "h3";
const tags = post.data.tags.slice(0, size === "compact" ? 2 : 4);
const dateLabel = new Intl.DateTimeFormat(toIntlLocale(locale), { month: "short", day: "numeric", year: "numeric" }).format(
  post.data.publishedAt,
);
---

<article class:list={["blog-card", `blog-card--${size}`]} style={`--tone: var(--${tone})`}>
  {
    post.data.coverImage && (
      <div class="blog-card__media">
        <img src={post.data.coverImage} alt="" loading="lazy" decoding="async" />
      </div>
    )
  }

  <div class="blog-card__body">
    <p class="meta-line">
      <time datetime={post.data.publishedAt.toISOString()}>{dateLabel}</time>
      {post.data.readingTimeMinutes && <span>{post.data.readingTimeMinutes} {t.common.minReadSuffix}</span>}
      {post.data.draft && <span class="blog-card__draft">{t.blogCard.draft}</span>}
    </p>
    <Heading class="blog-card__title">
      <a href={href}>{post.data.title}</a>
    </Heading>
    {size !== "compact" && <p class="blog-card__summary">{post.data.summary}</p>}
    {
      tags.length > 0 && (
        <ul class="chip-list blog-card__tags" aria-label={`${t.blogCard.tagsForPrefix} ${post.data.title}`}>
          {tags.map((tag) => (
            <li>
              <a class="chip" href={localizePath(locale, `/blog/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</article>

<style>
  .blog-card {
    position: relative;
    display: grid;
    gap: clamp(1rem, 2.4vw, 1.75rem);
    align-items: center;
    border-radius: var(--radius-xl);
    transition:
      transform var(--duration-base) var(--ease-spring),
      box-shadow var(--duration-base) var(--ease-out-soft),
      background var(--duration-base) ease;
  }

  /* Whole card is the link; tag chips sit above it. */
  .blog-card__title a {
    text-decoration: none;
  }

  .blog-card__title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }

  .blog-card__title a:focus-visible {
    outline: none;
  }

  .blog-card:has(.blog-card__title a:focus-visible) {
    outline: 2.5px solid var(--color-focus-ring);
    outline-offset: 4px;
  }

  .blog-card__tags {
    position: relative;
    z-index: 1;
  }

  .blog-card__media {
    overflow: hidden;
    aspect-ratio: 16 / 10;
    border-radius: 1.1rem;
    border: 1.5px solid var(--ink);
    background: var(--charcoal);
  }

  .blog-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease-out-soft);
  }

  .blog-card:hover .blog-card__media img {
    transform: scale(1.035);
  }

  .blog-card__body {
    display: grid;
    gap: var(--space-3);
    align-content: start;
  }

  .blog-card__title {
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .blog-card__summary {
    max-width: 38rem;
  }

  .blog-card__draft {
    color: var(--ink);
    font-weight: 700;
  }

  /* Feature: the newest post, on its own pastel tile. */
  .blog-card--feature {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    padding: clamp(0.9rem, 1.6vw, 1.15rem);
    background: var(--tone);
    border: 1.5px solid var(--ink);
  }

  .blog-card--feature .blog-card__body {
    padding: 0.5rem clamp(0.35rem, 1.5vw, 1.25rem);
  }

  .blog-card--feature .blog-card__title {
    font-size: clamp(1.8rem, 3.4vw, 2.8rem);
    letter-spacing: -0.05em;
  }

  .blog-card--feature .blog-card__summary {
    font-size: 1.1rem;
  }

  .blog-card--feature:hover,
  .blog-card--compact:hover {
    transform: translate(-3px, -3px);
    box-shadow: 6px 6px 0 var(--ink);
  }

  /* Row: a quiet list line that takes the tone on hover. */
  .blog-card--row {
    grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
    padding: 1rem;
    margin-inline: -1rem;
  }

  .blog-card--row:hover {
    background: var(--tone);
  }

  /* Compact: stacked card for "keep reading" grids. */
  .blog-card--compact {
    align-items: start;
    align-content: start;
    height: 100%;
    padding: clamp(0.9rem, 1.6vw, 1.1rem);
    background: var(--tone);
    border: 1.5px solid var(--ink);
  }

  .blog-card--compact .blog-card__body {
    padding: 0.25rem 0.4rem 0.4rem;
  }

  .blog-card--compact .blog-card__title {
    font-size: clamp(1.25rem, 1.8vw, 1.45rem);
  }

  @media (max-width: 52rem) {
    .blog-card--feature {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 40rem) {
    .blog-card--row {
      grid-template-columns: 1fr;
      padding: 0.75rem;
      margin-inline: -0.75rem;
    }
  }
</style>
