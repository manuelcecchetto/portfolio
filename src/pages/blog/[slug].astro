---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import BlogCard from "../../components/blog/BlogCard.astro";
import Callout from "../../components/prose/Callout.astro";
import ImageFigure from "../../components/prose/ImageFigure.astro";
import CodeNote from "../../components/prose/CodeNote.astro";
import { getBlogRouteSlugs, getLocalizedBlogPostBySlug, getLocalizedBlogPosts } from "../../lib/content";
import { getCopy, localizePath, resolveLocale, toIntlLocale } from "../../lib/i18n";
import { toneAt } from "../../lib/tones";

export async function getStaticPaths() {
  const slugs = await getBlogRouteSlugs({ includeDrafts: !import.meta.env.PROD });
  return slugs.map((slug) => ({ params: { slug }, props: { slug } }));
}

interface Props {
  slug: string;
}

const { slug: slugFromProps } = Astro.props as Props;
const slug = slugFromProps ?? Astro.params.slug;
const locale = resolveLocale(Astro.currentLocale);
if (!slug) {
  throw new Error("Missing blog slug param.");
}

const post = await getLocalizedBlogPostBySlug(slug, locale);
if (!post) {
  throw new Error(`Unable to resolve localized blog post for slug '${slug}' in locale '${locale}'.`);
}

// Tones follow the index order, so the band matches the post's card.
const localePosts = await getLocalizedBlogPosts(locale);
const position = localePosts.findIndex((entry) => entry.data.translationGroup === post.data.translationGroup);
const tagSet = new Set(post.data.tags);
const related = localePosts
  .map((entry, index) => ({ entry, tone: toneAt(index), overlap: entry.data.tags.filter((tag) => tagSet.has(tag)).length }))
  .filter(({ entry }) => entry.data.translationGroup !== post.data.translationGroup)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3);

const t = getCopy(locale);
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2);
const proseComponents = { Callout, ImageFigure, CodeNote };
const dateFormatter = new Intl.DateTimeFormat(toIntlLocale(locale), { month: "long", day: "numeric", year: "numeric" });
const publishedLabel = dateFormatter.format(post.data.publishedAt);
const updatedLabel = post.data.updatedAt ? dateFormatter.format(post.data.updatedAt) : undefined;
---

<BaseLayout
  title={`${post.data.title} | ${t.seo.blogDetailSuffix}`}
  description={post.data.summary}
  ogType="article"
  image={post.data.coverImage}
  tone={toneAt(Math.max(0, position))}
>
  <header class="page-hero post-hero motion-reveal" slot="hero">
    <a class="back-link" href={localizePath(locale, "/blog")}>{t.blogPost.backToAll}</a>
    <h1>{post.data.title}</h1>
    <p class="page-hero__lead">{post.data.summary}</p>
    <p class="meta-line">
      <time datetime={post.data.publishedAt.toISOString()}>{publishedLabel}</time>
      {updatedLabel && <span>{t.common.updatedPrefix} {updatedLabel}</span>}
      {post.data.readingTimeMinutes && <span>{post.data.readingTimeMinutes} {t.common.minReadSuffix}</span>}
      {post.data.draft && <span class="post-hero__draft">{t.blogPost.draftEntry}</span>}
    </p>
    {
      post.data.tags.length > 0 && (
        <ul class="chip-list" aria-label={t.blogPost.tagsAria}>
          {post.data.tags.map((tag) => (
            <li>
              <a class="chip" href={localizePath(locale, `/blog/tags/${encodeURIComponent(tag)}/`)}>{tag}</a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  {
    post.data.coverImage && (
      <img
        class="post-cover motion-reveal"
        src={post.data.coverImage}
        alt={`${t.blogPost.coverAltPrefix} ${post.data.title}`}
        loading="eager"
        decoding="async"
      />
    )
  }

  <div class="post-layout">
    <article class="prose">
      <Content components={proseComponents} />
    </article>
    {
      toc.length > 2 && (
        <nav class="post-toc" aria-labelledby="post-toc-title">
          <p id="post-toc-title" class="post-toc__title hand">{t.blogPost.onThisPage}</p>
          <ol>
            {toc.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ol>
        </nav>
      )
    }
  </div>

  {
    related.length > 0 && (
      <section aria-labelledby="post-related-title">
        <div class="section-head motion-reveal">
          <h2 id="post-related-title" class="section-title">{t.blogPost.continueReadingTitle}</h2>
          <a class="link-arrow" href={localizePath(locale, "/blog")}>{t.blogPost.backToAll}</a>
        </div>
        <ul class="post-related motion-stagger" role="list">
          {related.map(({ entry, tone }) => (
            <li>
              <BlogCard post={entry} tone={tone} size="compact" level={3} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>

<style>
  .post-hero h1 {
    max-width: 22ch;
    font-size: clamp(2.3rem, 5.4vw, 4.6rem);
  }

  .post-hero .page-hero__lead {
    max-width: 44rem;
  }

  .post-hero__draft {
    color: var(--ink);
    font-weight: 700;
  }

  .post-cover {
    width: 100%;
    max-height: 36rem;
    object-fit: cover;
    border-radius: var(--radius-xl);
    border: 1.5px solid var(--ink);
    box-shadow: 8px 8px 0 var(--ink);
    background: var(--charcoal);
  }

  .post-layout {
    display: grid;
    grid-template-columns: minmax(0, 42rem) minmax(12rem, 16rem);
    justify-content: space-between;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .post-toc {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: var(--space-3);
    padding-left: var(--space-5);
    border-left: 1.5px solid var(--ink);
  }

  .post-toc__title {
    font-size: 1.6rem;
    color: var(--ink);
  }

  .post-toc ol {
    display: grid;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .post-toc a {
    display: block;
    font-size: 0.95rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      color var(--duration-fast) ease,
      transform var(--duration-base) var(--ease-spring);
  }

  .post-toc a:hover {
    color: var(--ink);
    transform: translateX(3px);
  }

  .post-related {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 19rem), 1fr));
  }

  @media (max-width: 60rem) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
    }

    .post-toc {
      display: none;
    }
  }
</style>
